# LLM (OpenAI-compatible; 9router / OpenRouter / OpenAI)
LLM_BASE_URL=https://9r.grifyer.my.id/v1
LLM_API_KEY=sk-...
LLM_MODEL=Tier2
LLM_TEMPERATURE=0.1

# Postgres serverless (Neon / Supabase / any). Must allow SSL.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_ALLOWED_USER_IDS=123456789

# Market data
MARKET_PROVIDER=yfinance
# Dipakai otomatis bila provider utama gagal (mis. mt5 tanpa terminal).
MARKET_FALLBACK=
DEFAULT_SYMBOL=EURUSD
DEFAULT_TIMEFRAME=m1

# MetaTrader 5 (pakai MARKET_PROVIDER=mt5)
# Windows/Wine: MT5_PATH ke terminal64.exe. Linux: mt5linux bridge, isi MT5_HOST/PORT.
MT5_HOST=127.0.0.1
MT5_PORT=18812
MT5_LOGIN=0
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=
MT5_TIMEOUT=300
MT5_SYMBOL_SUFFIX=

# Risk / filters
MIN_RR=1.5
MAX_SPREAD_PIPS=2.0
