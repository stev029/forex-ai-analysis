# LLM (OpenAI-compatible; 9router / OpenRouter / OpenAI)
LLM_BASE_URL=https://9r.grifyer.my.id/v1
LLM_API_KEY=sk-...
LLM_MODEL=Tier2
LLM_TEMPERATURE=0.1

# Model per-tahap agent. Kosong = ikut LLM_MODEL.
# Tahap ringan (tren/validasi/area kritis) -> model murah tapi akurat.
# Tahap berat (keputusan entry, SL/TP) -> model kuat.
LLM_MODEL_TREND=gemini/gemini-3.5-flash-lite
LLM_MODEL_VALIDATION=gemini/gemini-3.5-flash-lite
LLM_MODEL_CRITICAL=gemini/gemini-3.5-flash-lite
LLM_MODEL_DECISION=abacus/gpt-6-sol

# Rantai fallback (dipisah koma) bila model utama gagal / kuota habis.
LLM_FALLBACK_TREND=abacus/gpt-6-sol
LLM_FALLBACK_VALIDATION=abacus/gpt-6-sol
LLM_FALLBACK_CRITICAL=abacus/gpt-6-sol
LLM_FALLBACK_DECISION=abacus/claude-opus-5-5
# Fallback terakhir untuk semua tahap.
LLM_FALLBACKS=Tier2

# Postgres serverless (Neon / Supabase / any). Must allow SSL.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_ALLOWED_USER_IDS=123456789

# Market data
MARKET_PROVIDER=tradingview
# Dipakai otomatis bila provider utama gagal (mis. websocket TradingView diblokir).
MARKET_FALLBACK=yfinance
DEFAULT_SYMBOL=EURUSD
DEFAULT_TIMEFRAME=m1
DEFAULT_MODE=cascade

# TradingView (pakai MARKET_PROVIDER=tradingview)
# FX = FX:EURUSD, OANDA = OANDA:EURUSD, FX_IDC = FX_IDC:EURUSD
TV_EXCHANGE=FX
# data | prodata | widgetdata
TV_SERVER=data
TV_TIMEOUT=25
TV_RANGE=300
TV_RETRIES=3
TV_DEBUG=false

# Risk / filters
MIN_RR=1.5
MAX_SPREAD_PIPS=2.0
